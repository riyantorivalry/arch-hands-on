GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# Optional image overrides. Keep images pinned; do not use floating latest in production.
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.0.1-security-01
LOKI_IMAGE=grafana/loki:3.7.2
ALLOY_IMAGE=grafana/alloy:v1.16.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector:0.152.0
TEMPO_IMAGE=grafana/tempo:2.10.5
PYROSCOPE_IMAGE=grafana/pyroscope:2.0.1
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.19.1

POSTGRES_PRIMARY_EXPORTER_URI=host.docker.internal:5432/platform?sslmode=disable
POSTGRES_PRIMARY_EXPORTER_USER=platform
POSTGRES_PRIMARY_EXPORTER_PASSWORD=platform
POSTGRES_REPLICA_EXPORTER_URI=host.docker.internal:5433/platform?sslmode=disable
POSTGRES_REPLICA_EXPORTER_USER=platform
POSTGRES_REPLICA_EXPORTER_PASSWORD=platform
