GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-running
GRAFANA_ROOT_URL=http://localhost:3000

PLATFORM_ENVIRONMENT=local
PLATFORM_BACKEND_METRICS_TARGET=host.docker.internal:8080

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
LOKI_BIND_ADDRESS=127.0.0.1
LOKI_PORT=3100
ALLOY_BIND_ADDRESS=127.0.0.1
ALLOY_PORT=12345
OTLP_GRPC_BIND_ADDRESS=127.0.0.1
OTLP_GRPC_PORT=4317
OTLP_HTTP_BIND_ADDRESS=127.0.0.1
OTLP_HTTP_PORT=4318
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093
TEMPO_BIND_ADDRESS=127.0.0.1
TEMPO_PORT=3200
ZIPKIN_BIND_ADDRESS=127.0.0.1
ZIPKIN_PORT=9411
PYROSCOPE_BIND_ADDRESS=127.0.0.1
PYROSCOPE_PORT=4040
POSTGRES_PRIMARY_EXPORTER_BIND_ADDRESS=127.0.0.1
POSTGRES_PRIMARY_EXPORTER_PORT=9187
POSTGRES_REPLICA_EXPORTER_BIND_ADDRESS=127.0.0.1
POSTGRES_REPLICA_EXPORTER_PORT=9188
OPENSEARCH_BIND_ADDRESS=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_BIND_ADDRESS=127.0.0.1
OPENSEARCH_PERF_PORT=9600
OPENSEARCH_DASHBOARDS_BIND_ADDRESS=127.0.0.1
OPENSEARCH_DASHBOARDS_PORT=5601
TOXIPROXY_BIND_ADDRESS=127.0.0.1
TOXIPROXY_PORT=8474
OPENSEARCH_PROXY_BIND_ADDRESS=127.0.0.1
OPENSEARCH_PROXY_PORT=9201

# Optional image overrides. Keep images pinned; do not use floating latest in production.
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.0.1-security-01
LOKI_IMAGE=grafana/loki:3.7.2
ALLOY_IMAGE=grafana/alloy:v1.16.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1
TEMPO_IMAGE=grafana/tempo:2.10.5
PYROSCOPE_IMAGE=grafana/pyroscope:2.0.1
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.19.1

POSTGRES_PRIMARY_EXPORTER_URI=host.docker.internal:5432/platform?sslmode=disable
POSTGRES_PRIMARY_EXPORTER_USER=platform
POSTGRES_PRIMARY_EXPORTER_PASSWORD=platform
POSTGRES_REPLICA_EXPORTER_URI=host.docker.internal:5433/platform?sslmode=disable
POSTGRES_REPLICA_EXPORTER_USER=platform
POSTGRES_REPLICA_EXPORTER_PASSWORD=platform
