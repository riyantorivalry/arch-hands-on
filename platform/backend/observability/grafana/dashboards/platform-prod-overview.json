      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"platform-backend\",uri!~\"/actuator.*\"}[$__rate_interval]))", "refId": "A" }
      ],
      "title": "Request Rate",
      "type": "stat"
