      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"platform-backend\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"platform-backend\",uri!~\"/actuator.*\"}[$__rate_interval])), 0.001)", "refId": "A" }
      ],
      "title": "5xx Error Rate",
      "type": "stat"
