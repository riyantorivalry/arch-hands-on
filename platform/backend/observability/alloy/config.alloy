logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "platform" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.memory_limiter.platform.input]
  }
}

otelcol.processor.memory_limiter "platform" {
  check_interval = "5s"
  limit          = "512MiB"
  spike_limit    = "128MiB"

  output {
    traces = [otelcol.processor.batch.platform.input]
  }
}

otelcol.processor.batch "platform" {
  timeout         = "5s"
  send_batch_size = 1024

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

loki.source.file "platform_json_logs" {
  targets = [
    {
      __path__      = "/var/log/platform/*.json.log",
      job           = "platform-backend-logs",
      service_name  = "platform-backend",
      environment   = "local",
    },
  ]

  forward_to = [loki.process.platform_json.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.process "platform_json" {
  stage.json {
    drop_malformed = true
    expressions = {
      extracted_level          = "level",
      extracted_logger         = "logger_name",
      extracted_service        = "service",
      extracted_trace_id       = "traceId",
      extracted_correlation_id = "correlationId",
      extracted_tenant_id      = "tenantId",
    }
  }

  stage.labels {
    values = {
      level        = "extracted_level",
      service_name = "extracted_service",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
